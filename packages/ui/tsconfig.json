{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "jsx": "react-native",
    "lib": [
      "dom",
      "es2022"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true
  },
  "include": [
    "index.ts",
    "react-native.d.ts",
    "tanstack-table.d.ts",
    "theme/**/*",
    "components/**/*",
    "tables/**/*"
  ]
}